# App
APP_NAME=gin-app
APP_VERSION=1.0.0
APP_ENV=development
# HTTP settings
HTTP_PORT=8080
HTTP_USE_PREFORK_MODE=false
HTTP_COOKIE_NAME=app_cookie_name
# JWT
JWT_SECRET=jwt_secret
# Logger
LOG_DIR=./logs
LOG_LEVEL=debug
# PG
PG_POOL_MAX=2
PG_URL=postgres://user:myAwEsOm3pa55@w0rd@localhost:5432/db
# Redis
REDIS_URL=redis://<user>:<password>@<host>:<port>/<db_number>
# gRPC
GRPC_PORT=8081
# RMQ
RMQ_RPC_SERVER=rpc_server
RMQ_RPC_CLIENT=rpc_client
RMQ_URL=amqp://guest:guest@localhost:5672/
# NATS
NATS_RPC_SERVER=rpc_server
NATS_URL=nats://guest:guest@localhost:4222/
# Sentry
SENTRY_DSN=https://<public_key>@<host>/<project_id>
# Metrics
METRICS_ENABLED=true
# Swagger
SWAGGER_ENABLED=true
# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=
# Github OAuth2
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=